{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/disk-hook.sh",
            "timeout": 15,
            "statusMessage": "Checking disk space..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard-hook.sh",
            "timeout": 20,
            "statusMessage": "Checking security guards..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-summary.sh check",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
